# OMDA Mobile — variables d'environnement (préfixe EXPO_PUBLIC_).
# Copiez ce fichier en `.env` (ignoré par git) puis renseignez vos valeurs.
# Détails du branchement : docs/BRANCHEMENT.md

# Mode démonstration : `true` (défaut) = données mockées ; `false` = services réels.
EXPO_PUBLIC_USE_MOCKS=true

# Supabase (Auth + DB + Storage) — requis uniquement si EXPO_PUBLIC_USE_MOCKS=false.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# API REST Express du parcours candidat (optionnel) — requis uniquement si
# EXPO_PUBLIC_USE_MOCKS=false et que le parcours candidat doit être branché.
EXPO_PUBLIC_API_BASE_URL=

