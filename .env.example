# OMDA Mobile — variables d'environnement (préfixe EXPO_PUBLIC_).
# Copiez ce fichier en `.env` (ignoré par git) puis renseignez vos valeurs.
# Détails du branchement : docs/BRANCHEMENT.md

# --- Supabase (Auth + DB + Storage) : parcours MEMBRE connecté ---
# Requis uniquement si le parcours membre est branché (EXPO_PUBLIC_USE_MOCKS_MEMBER=false).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- API REST Express : parcours CANDIDAT (visiteur / candidat, sans compte) ---
# Requis uniquement si le parcours candidat est branché.
# ⚠️ Si cette variable est VIDE, le parcours candidat RESTE EN MOCK, même avec
# EXPO_PUBLIC_USE_MOCKS_CANDIDATE=false : sans API à joindre, le mock est conservé.
EXPO_PUBLIC_API_BASE_URL=

# --- Repli historique (compatibilité) ---
# Utilisé SEULEMENT si le flag du parcours correspondant n'est pas défini :
# `false` = services réels pour les parcours non renseignés ; toute autre valeur
# (y compris une variable absente) = mocks. `true` par défaut.
EXPO_PUBLIC_USE_MOCKS=true

# --- Sélection mock ⇄ réel : UN FLAG PAR PARCOURS ---
# `true` (défaut) = mocks ; `false` = services réels ; toute autre valeur = mocks.
# Parcours MEMBRE (connecté) : auth + données + contenus publics (Supabase).
EXPO_PUBLIC_USE_MOCKS_MEMBER=true
# Parcours CANDIDAT (sans compte) : adhésion, suivi, paiement Mobile Money (API REST Express).
EXPO_PUBLIC_USE_MOCKS_CANDIDATE=true

